# syntax=docker/dockerfile:1

# Development image: full Go toolchain plus live reload via Air.
# Production uses ./Dockerfile (multi-stage, distroless, non-root).
FROM golang:1.23-alpine

ARG AIR_VERSION=v1.61.7

RUN apk add --no-cache curl git \
    && go install github.com/air-verse/air@${AIR_VERSION}

WORKDIR /src

# Cache modules separately from source so rebuilds stay fast.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV APP_ENV=development \
    PORT=8080 \
    CGO_ENABLED=0

EXPOSE 8080

# Readiness includes a database ping; -f makes curl exit non-zero on 503.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
    CMD ["curl", "-fsS", "http://127.0.0.1:8080/ready"]

CMD ["air", "-c", ".air.toml"]
